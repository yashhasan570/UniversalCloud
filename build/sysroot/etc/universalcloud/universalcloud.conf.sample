[app]
PAGE_SIZE = 10
RuntimeRootPath = runtime/
LogPath = /var/log/universalcloud/
LogSaveName = log
LogFileExt = log
DateStrFormat = 20060102
DateTimeFormat = 2006-01-02 15:04:05
TimeFormat = 15:04:05
DateFormat = 2006-01-02
DBPath     = /var/lib/universalcloud
ShellPath  = /usr/share/universalcloud/shell
UserDataPath = /var/lib/universalcloud/conf

[server]
RunMode = release
ServerApi = https://api.universalcloud.app/universalcloud-api
Handshake = socket.universalcloud.app
Token = 
USBAutoMount =

[system]